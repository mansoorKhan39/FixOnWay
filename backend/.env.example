# Copy this file to ".env" and fill it in.
PORT=5000

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/fixonway
# MongoDB Atlas (free M0 cluster) looks like:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fixonway?retryWrites=true&w=majority

# Any long random text. Never share it.
JWT_SECRET=change-this-to-a-long-random-text
JWT_EXPIRES_IN=7d

# Who may call the API from a browser. "*" is fine for the lab project.
CORS_ORIGIN=*
